{
  "manifest_version": 3,
  "name": "GhostSplit.gg Chat Theme for Twitch.tv",
  "version": "0.3.3",
  "description": "Restyles native twitch.tv chat to match the GhostSplit chat look — dark and light themes supported. Bits and channel-points UI preserved.",
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-chat-theme@ghostsplit.gg",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "css": ["content/twitch-chat.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content/badges.js", "content/toggle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
